{
  "name": "@growloop/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts scripts/migrate.ts --format esm",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "smoke:e2b": "tsx scripts/e2b-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@growloop/shared": "0.1.0",
    "@octokit/app": "^15.1.2",
    "@octokit/rest": "^21.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "e2b": "^2.19.1",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "pg": "^8.13.1",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
